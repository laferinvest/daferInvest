# Copie este arquivo para .env e preencha com seus dados reais

# Chaves do Stripe (encontre em https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXX

# Webhook secret (gerado ao configurar webhook no painel do Stripe)
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# IDs dos produtos criados no painel do Stripe
# Crie em: https://dashboard.stripe.com/products
STRIPE_PRICE_EBOOK=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_CONSULTORIA_AVULSA=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_CONSULTORIA_MENSAL=price_XXXXXXXXXXXXXXXXXXXXXXXX

# URL base do seu site (sem barra no final)
BASE_URL=https://seusite.com.br

# Porta do servidor
PORT=3000
